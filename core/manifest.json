{
  "action": {
    "default_title": "OpenSaysMe",
    "default_popup": "popup.html",
    "default_icon": {
      "19": "images/opensaysme-19.png",
      "38": "images/opensaysme-38.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.inkl.com/*",
        "*://*.nationalgeographic.com/*",
        "*://*.nyteknik.se/*",
        "*://*.nzherald.co.nz/*",
        "*://*.gitlab.com/magnolia1234"
      ],
      "run_at": "document_start",
      "js": [
        "contentScript_once.js"
      ]
    },
    {
      "css": [
        "css/content.css"
      ],
      "js": [
        "shared/storage.js",
        "js/oahelperSafeDom.js",
        "js/content.js"
      ],
      "matches": [
        "*://*/*",
        "http://*/*",
        "https://*/*"
      ]
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/bpc-loader.js"
      ],
      "run_at": "document_end"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data:"
  },
  "default_locale": "en",
  "description": "News access tools and open-access research discovery in one extension.",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "images/opensaysme-16.png",
    "32": "images/opensaysme-32.png",
    "48": "images/opensaysme-48.png",
    "128": "images/opensaysme-128.png",
    "256": "images/opensaysme-256.png",
    "512": "images/opensaysme-512.png"
  },
  "manifest_version": 3,
  "name": "OpenSaysMe",
  "options_ui": {
    "open_in_tab": true,
    "page": "settings.html"
  },
  "permissions": [
    "tabs",
    "storage",
    "contextMenus",
    "scripting",
    "cookies",
    "webRequest",
    "declarativeNetRequestWithHostAccess"
  ],
  "storage": {
    "managed_schema": "schema.json"
  },
  "version": "1.0.1",
  "web_accessible_resources": [
    {
      "matches": [
        "*://*/*"
      ],
      "resources": [
        "css/*.css"
      ]
    },
    {
      "matches": [
        "*://*/*"
      ],
      "resources": [
        "js/*.js"
      ]
    },
    {
      "matches": [
        "*://*/*"
      ],
      "resources": [
        "html/*.html"
      ]
    },
    {
      "matches": [
        "*://*/*"
      ],
      "resources": [
        "images/*.png"
      ]
    },
    {
      "matches": [
        "*://*/*"
      ],
      "resources": [
        "images/*.gif"
      ]
    },
    {
      "matches": [
        "*://*/*"
      ],
      "resources": [
        "images/*.jpg"
      ]
    },
    {
      "matches": [
        "*://*/*"
      ],
      "resources": [
        "images/*.svg"
      ]
    }
  ],
  "short_name": "OpenSaysMe",
  "minimum_chrome_version": "120"
}
